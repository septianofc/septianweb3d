                return localStorage.getItem('theme');
            } catch (error) {
                return null;
            }
        }

        function saveTheme(theme) {
            try {
                localStorage.setItem('theme', theme);
            } catch (error) {
                // Tema tetap berubah meskipun penyimpanan tidak tersedia.
            }
        }

        (function initDarkMode() {
            const darkModeToggle = document.getElementById('darkModeToggle');
            const darkModeIcon = darkModeToggle.querySelector('i');
            const body = document.body;

            function applyTheme(isDark) {
                if (isDark) {
                    body.classList.add('dark-mode');
                    darkModeIcon.classList.remove('fa-moon');
                    darkModeIcon.classList.add('fa-sun');
                    darkModeToggle.setAttribute('aria-label', 'Aktifkan Mode Terang');
                    darkModeToggle.setAttribute('title', 'Aktifkan Mode Terang');
                    const metaTheme = document.querySelector('meta[name="theme-color"]');
                    if (metaTheme) metaTheme.setAttribute('content', '#0f172a');
                } else {
                    body.classList.remove('dark-mode');
                    darkModeIcon.classList.remove('fa-sun');
                    darkModeIcon.classList.add('fa-moon');
                    darkModeToggle.setAttribute('aria-label', 'Aktifkan Mode Gelap');
                    darkModeToggle.setAttribute('title', 'Aktifkan Mode Gelap');
                    const metaTheme = document.querySelector('meta[name="theme-color"]');
                    if (metaTheme) metaTheme.setAttribute('content', '#42a5f5');
                }
            }

            const savedTheme = getSavedTheme();
            const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            const isDark = savedTheme === 'dark' || (!savedTheme && prefersDark);
            applyTheme(isDark);

            darkModeToggle.addEventListener('click', () => {
                const nowDark = !body.classList.contains('dark-mode');
                applyTheme(nowDark);
                saveTheme(nowDark ? 'dark' : 'light');
            });
        })();

        // =========================================================
        // ACHIEVEMENT COUNTER - FIX (angka & label selalu tampil,
        // animasi berjalan, fallback jika gagal)
        // =========================================================
        (function initAchievementCounters() {
            const cards = document.querySelectorAll('.achievement-number');
            if (!cards.length) return;

            function animateCounter(el) {
                const targetStr = el.getAttribute('data-target');
                const target = parseInt(targetStr, 10);
                if (isNaN(target)) return;

                el.style.visibility = 'visible';
                el.style.opacity = '1';

                const duration = 1500;
                const startTime = performance.now();

                function step(now) {
                    const elapsed = now - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    const current = Math.floor(target * eased);
                    el.textContent = String(current);
                    if (progress < 1) {
                        requestAnimationFrame(step);
                    } else {
                        el.textContent = String(target);
                    }
                }

                el.textContent = '0';
                requestAnimationFrame(step);
            }

            if ('IntersectionObserver' in window) {
                const observer = new IntersectionObserver((entries, obs) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            animateCounter(entry.target);
                            obs.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.4 });
                cards.forEach(el => observer.observe(el));
            } else {
                cards.forEach(el => animateCounter(el));
            }

            // FALLBACK: jika setelah 3 detik angka masih "0", paksa tampilkan angka final
            setTimeout(() => {
                cards.forEach(el => {
                    if (el.textContent.trim() === '0' || el.textContent.trim() === '') {
                        const target = el.getAttribute('data-target');
                        if (target) el.textContent = target;
                    }
                });
            }, 3000);
        })();

