        (function initRecaptchaBadge() {
            let expanded = false; let overlay = null;
            function findBadge() { return document.querySelector('.grecaptcha-badge'); }
            function createOverlay() {
                if (overlay) return;
                overlay = document.createElement('div');
                overlay.id = 'recaptchaTouchOverlay';
                overlay.style.cssText = 'position:fixed;width:70px;height:60px;right:15px;bottom:20px;z-index:9999;background:transparent;cursor:pointer;border-radius:6px;';
                overlay.addEventListener('click', function(e) {
                    e.preventDefault(); e.stopPropagation();
                    const badge = findBadge(); if (!badge) return;
                    if (!expanded) {
                        badge.classList.remove('recaptcha-closing');
                        badge.classList.add('recaptcha-expanded');
                        expanded = true;
                        setTimeout(() => { if (overlay) overlay.style.display = 'none'; }, 400);
                    }
                });
                document.body.appendChild(overlay);
            }
            function collapseBadge() {
                const badge = findBadge(); if (!badge) return;
                badge.classList.remove('recaptcha-expanded');
                badge.classList.add('recaptcha-closing');
                expanded = false;
                setTimeout(() => { badge.classList.remove('recaptcha-closing'); if (overlay) overlay.style.display = 'block'; }, 350);
            }
            const observer = new MutationObserver(() => { const badge = findBadge(); if (badge && !overlay) createOverlay(); });
            observer.observe(document.body, { childList: true, subtree: true });
            setTimeout(() => { if (findBadge()) createOverlay(); }, 1500);
            document.addEventListener('click', function(e) {
                const badge = findBadge(); if (!badge || !expanded) return;
                const rect = badge.getBoundingClientRect();
                const inside = e.clientX >= rect.left && e.clientX <= rect.right && e.clientY >= rect.top && e.clientY <= rect.bottom;
