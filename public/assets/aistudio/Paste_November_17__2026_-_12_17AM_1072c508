            function createQR() {
                if (typeof QRCode === 'undefined') return false;

                if (qrReady && qrContainer.querySelector('canvas')) return true;

                qrContainer.replaceChildren();

                try {
                    new QRCode(qrContainer, {
                        text: PORTFOLIO_URL,
                        width: 400,
                        height: 400,
                        colorDark: '#111827',
                        colorLight: '#ffffff',
                        correctLevel: QRCode.CorrectLevel.H
                    });

                    const canvas = qrContainer.querySelector('canvas');

                    if (!canvas) {
                        qrContainer.replaceChildren();
                        return false;
                    }

                    const generatedImage = qrContainer.querySelector('img');
                    if (generatedImage) generatedImage.remove();

                    qrReady = true;
                    return true;
                } catch (error) {
                    qrContainer.replaceChildren();
                    return false;
                }
            }

            if (!createQR()) {
                qrContainer.textContent = 'QR Code sedang dimuat. Silakan coba lagi.';
            }

            if (downloadBtn) {
                downloadBtn.addEventListener('click', async function () {
                    if (!createQR()) {
                        showMessage('error', 'QR belum siap', 'Periksa koneksi internet lalu muat ulang halaman.');
                        return;
                    }

                    const canvas = qrContainer.querySelector('canvas');
                    if (!canvas) {
                        showMessage('error', 'Gagal', 'Canvas QR tidak ditemukan.');
                        return;
                    }

                    const originalHTML = downloadBtn.innerHTML;
                    downloadBtn.disabled = true;
                    downloadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menyiapkan PNG...';

                    let objectURL = null;

                    try {
                        const blob = await new Promise((resolve, reject) => {
                            canvas.toBlob(result => {
                                if (result) resolve(result);
                                else reject(new Error('PNG tidak dapat dibuat.'));
                            }, 'image/png');
                        });

                        objectURL = URL.createObjectURL(blob);

                        const link = document.createElement('a');
                        link.href = objectURL;
                        link.download = 'septianfr-qrcode.png';
                        link.style.display = 'none';
                        document.body.appendChild(link);
                        link.click();
                        link.remove();

                        showMessage(
                            'info',
                            'Unduhan dimulai',
                            'Jika file tidak tersimpan otomatis, buka tautan gambar di tab baru atau izinkan unduhan di browser.'
                        );
                    } catch (error) {
                        try {
                            const dataURL = canvas.toDataURL('image/png');
                            const tab = window.open(dataURL, '_blank');

                            if (!tab) {
                                showMessage('warning', 'Unduhan diblokir', 'Izinkan pop-up browser, lalu coba unduh lagi.');
                            } else {
                                showMessage('info', 'QR siap disimpan', 'Pada tab gambar yang terbuka, gunakan menu browser untuk mengunduh atau menyimpan gambar.');
                            }
                        } catch (fallbackError) {
                            showMessage('error', 'Gagal membuat PNG', 'Coba gunakan browser lain atau periksa pengaturan unduhan.');
                        }
                    } finally {
                        downloadBtn.disabled = false;
                        downloadBtn.innerHTML = originalHTML;

                        if (objectURL) {
                            setTimeout(() => URL.revokeObjectURL(objectURL), 60000);
                        }
                    }
                });
            }

            if (copyBtn) {
